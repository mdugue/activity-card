{
  "permissions": {
    "allow": [
      "Bash(bunx lint)",
      "Bash(bunx ultracite *)",
      "Bash(bunx typecheck)",
      "Bash(git mv *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun fix --skip=correctness/noUnusedImports"
          }
        ]
      }
    ]
  }
}
