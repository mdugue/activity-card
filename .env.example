# Strava OAuth — register an app at https://www.strava.com/settings/api
# Category: "Visualizer". Authorization Callback Domain: bare host (e.g.
# `localhost` for dev, your prod domain for prod). Strava does not accept
# paths in that field — the path comes from STRAVA_REDIRECT_URI below.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Optional overrides used by the E2E mock (see docs/strava.md). Leave unset
# in normal local dev to talk to the real Strava API.
# STRAVA_OAUTH_URL=https://www.strava.com/oauth/authorize
# STRAVA_TOKEN_URL=https://www.strava.com/oauth/token
# STRAVA_API_BASE=https://www.strava.com/api/v3

# Set to "1" only when running over plain http (E2E, some local-dev
# setups). Otherwise leave unset; production cookies stay Secure.
# STRAVA_INSECURE_COOKIES=
