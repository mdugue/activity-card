    "node-vibrant": "^4.0.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "3.10.1",
    "remotion": "4.0.527",
    "shadcn": "^4.21.0",
