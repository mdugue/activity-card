{
  "name": "activity-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ultracite check --type-aware",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "fix": "ultracite fix",
    "test": "bun test ./lib ./theme",
    "test:watch": "bun test ./lib ./theme --watch",
    "test:coverage": "bun test ./lib ./theme --coverage",
    "test:e2e": "playwright test",
    "generate-icons": "bun run scripts/generate-icons.ts",
    "strava:types": "bunx --bun swagger2openapi https://developers.strava.com/swagger/swagger.json --outfile strava-oas3.tmp.json && openapi-typescript strava-oas3.tmp.json -o lib/strava-api.generated.ts && rm -f strava-oas3.tmp.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "video:studio": "remotion studio",
    "video:render": "remotion render",
    "check": "ultracite check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
